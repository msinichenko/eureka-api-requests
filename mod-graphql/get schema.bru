meta {
  name: get schema
  type: http
  seq: 2
}

post {
  url: https://kong-{{folio}}.{{domain}}/graphql
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  x-okapi-tenant: {{realm}}
  x-okapi-token: {{okapi-token}}
}

body:json {
  {
    "query": "{ __schema { queryType { name } } }"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
