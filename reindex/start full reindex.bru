meta {
  name: start full reindex
  type: http
  seq: 13
}

post {
  url: https://kong-{{folio}}.{{domain}}/search/index/instance-records/reindex/full
  body: json
  auth: none
}

headers {
  x-okapi-token: {{okapi-token}}
  x-okapi-tenant: {{realm}}
}

body:json {
  {
      "indexSettings": {
          "refreshInterval": -1,
          "numberOfReplicas": 0
      }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  https://github.com/folio-org/mod-search/blob/master/docs/features/reindex/reindex-full-kafka.md#step-1-trigger-full-reindex
}
